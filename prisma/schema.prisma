generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoPublicacion {
  ARTICULO_REGIONAL
  ARTICULO_ALTO_IMPACTO
  LIBRO
  CAPITULO_LIBRO
  MEMORIA_EVENTO
  PROPIEDAD_INTELECTUAL
}

enum CategoriaDocente {
  AUXILIAR_I
  AUXILIAR_II
  AGREGADO_I
  AGREGADO_II
  AGREGADO_III
  PRINCIPAL_I
  PRINCIPAL_II
}

enum EstadoPublicacion {
  PUBLICADO
  ACEPTADO
  OTRO
}

model Contribution {
  id                     String   @id @default(cuid())
  codigo_ies             String   @default("ULEAM")
  facultad               String   @default("Facultad de Educación y Turismo")
  carrera                String   @default("Pedagogía de los Idiomas Nacionales y Extranjeros")
  tipoPublicacion        TipoPublicacion
  tipoArticulo           String?   // solo para artículos
  codigoPublicacion      String?   // opcional
  proyecto               String?
  proyectoId             String?   // proyectos.id — de qué proyecto es; lo usa el líder para eliminar (lib/permisosContribucion.ts)
  titulo                 String
  tituloLibro            String?   // para libros y capítulos
  nombreRevista          String?   // para artículos
  issn                   String?
  isbn                   String?
  fechaPublicacion       DateTime
  campoDetallado         String
  estado                 EstadoPublicacion
  linkPublicacion        String?   // opcional
  linkRevista            String?   // opcional
  filiacion              String?
  identificacionParticipante String?
  categoria              CategoriaDocente?
  participacion          String?
  cuartil                String?
  lineaInvestigacion    String
  periodoAcademico      String
  intercultural          String?
  baseDatosIndexada     String?   // artículos regionales/alto impacto
  revisadoPares         Boolean  @default(true) // libros
  tituloCapitulo        String?   // capítulos
  editorCompilador      String?   // capítulos
  paginas               String?   // capítulos
  totalCapituloLibro    Int?      // capítulos
  nombrePonencia        String?   // memoria de eventos
  nombreEvento          String?   // memoria de eventos
  edicionEvento         String?   // memoria de eventos
  organizadorEvento     String?   // memoria de eventos
  comiteOrganizador     String?   // memoria de eventos
  pais                  String?   // memoria de eventos
  ciudad                String?   // memoria de eventos
  certificadoN          String?   // propiedad intelectual
  solicitudN            String?   // propiedad intelectual
  claseDeObra           String?   // propiedad intelectual
  tituloObra            String?   // propiedad intelectual
  lugar                 String?   // propiedad intelectual
  fechaSubida            DateTime @default(now())
  validadoPor            String?   // id del admin que valida
  fechaValidacion        DateTime?
  creadoPorId            Int?      // usuarios.id de quien la registró — permite editar solo lo propio
  origen                 String   @default("docente") // 'docente' | 'enlace_externo' (QR de enlaces_contribucion)
  aprobada               Boolean  @default(true)      // enlace_externo nace false; solo las aprobadas cuentan en estadísticas
  registradorExternoNombre   String?
  registradorExternoContacto String?
  authors                ContributionAuthor[]
}

model ContributionAuthor {
  id               String   @id @default(cuid())
  contributionId   String
  contribution     Contribution @relation(fields: [contributionId], references: [id])
  authorName       String
  order            Int      // 1..6
  isCarreraAuthor  Boolean
  esEstudiante     Boolean  @default(false) // solo aplica si isCarreraAuthor=true; docente vs estudiante de la carrera
  usuarioId        Int?     // usuarios.id del docente autor (NULL = externo/estudiante o nombre ambiguo)
}
